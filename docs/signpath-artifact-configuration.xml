<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration for Android Guardian (slug: exe). See docs/signing.md.
     The GitHub artifact "unsigned-exe" is a zip that contains only AndroidGuardian.exe.
     adb.exe and aapt2.exe are signed by Google already and are not part of the signing request. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="AndroidGuardian.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
